OPENAI_API_KEY=your-key-here-or-demo
LLM_MODEL=gpt-4o-mini
ARTIFACT_DIR=./artifacts
API_PORT=8080

# Endpoint OpenAI-compatible opcional (servidor LOCAL: gratis, sin salir a internet).
# Si se setea, se usa este en vez de api.openai.com y no hace falta key real.
# Ejemplo con Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=gemma4:latest
#   OPENAI_API_KEY=local
